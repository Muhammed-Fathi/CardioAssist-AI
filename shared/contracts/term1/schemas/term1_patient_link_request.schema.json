{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_patient_link_request.schema.json.schema.json",
  "title": "term1_patient_link_request.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "access_code",
    "identifier",
    "accept_linking"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "access_code": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256
    },
    "identifier": {
      "type": "string",
      "maxLength": 64
    },
    "accept_linking": {
      "type": "boolean"
    }
  }
}
