{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_auth_me_response.schema.json.schema.json",
  "title": "term1_auth_me_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "user_id",
    "role",
    "status",
    "password_change_required"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "role": {
      "type": "string"
    },
    "profile_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "maxLength": 16
    },
    "password_change_required": {
      "type": "boolean"
    }
  }
}
