{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_me_password_response.schema.json.schema.json",
  "title": "term1_me_password_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "user_id",
    "changed_at",
    "sessions_revoked"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "password_change_required": {
      "type": "boolean"
    },
    "sessions_revoked": {
      "type": "integer",
      "minimum": 0
    }
  }
}
