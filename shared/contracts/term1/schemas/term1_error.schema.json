{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_error.schema.json",
  "title": "term1_error",
  "type": "object",
  "required": [
    "contract_version",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version. Only 'v1' is defined."
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {}
        }
      }
    }
  }
}
