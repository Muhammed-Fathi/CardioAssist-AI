{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_patient_register_request.schema.json",
  "title": "term1_patient_register_request.schema.json",
  "type": "object",
  "required": [
    "access_code",
    "identifier",
    "email",
    "password",
    "consent_ack"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "access_code": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256
    },
    "identifier": {
      "type": "string",
      "maxLength": 64
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "consent_ack": {
      "type": "boolean"
    }
  }
}
