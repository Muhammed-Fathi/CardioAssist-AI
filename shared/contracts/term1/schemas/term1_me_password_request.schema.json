{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_me_password_request.schema.json.schema.json",
  "title": "term1_me_password_request.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "current_password",
    "new_password"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "new_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
