{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_admin_status_request.schema.json.schema.json",
  "title": "term1_admin_status_request.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "reason_code"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "status": {
      "type": "string",
      "maxLength": 16
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
