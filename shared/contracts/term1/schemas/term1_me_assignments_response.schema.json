{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_me_assignments_response.schema.json",
  "title": "term1_me_assignments_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "assignments"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignment_id",
          "doctor_label",
          "active",
          "assigned_at"
        ],
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "doctor_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "active": {
            "type": "boolean"
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {}
        }
      }
    }
  }
}
