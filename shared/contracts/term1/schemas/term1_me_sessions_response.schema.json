{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_me_sessions_response.schema.json.schema.json",
  "title": "term1_me_sessions_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "session_id",
          "created_at",
          "expires_at",
          "current",
          "active"
        ],
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {},
          "current": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
