{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_invitation_get_response.schema.json.schema.json",
  "title": "term1_invitation_get_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "invitation_id",
    "status",
    "issued_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract major version; only 'v1' is served."
    },
    "invitation_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "visit_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CONSUMED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_at": {},
    "revoked_at": {},
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    }
  }
}
