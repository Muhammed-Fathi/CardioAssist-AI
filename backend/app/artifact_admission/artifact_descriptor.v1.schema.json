{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/internal/artifact_admission/artifact_descriptor.v1.schema.json",
  "title": "CardioAssist AI — offline research model artifact descriptor (v1)",
  "description": "Structural description of a research model package for OFFLINE admission checks. This is an internal engineering descriptor, not an API contract and not an approval record. Admission is always RESEARCH_ONLY: no descriptor, checksum or model file can grant scientific, clinical or serving approval.",
  "x-status": "RESEARCH_ONLY_INTERNAL_ENGINEERING",
  "x-not-an-approval": "A descriptor that passes every check is admitted to local research tooling only. Interpretation, calibration adequacy and clinical validity require separate human, scientific and clinical review.",
  "type": "object",
  "required": [
    "descriptor_schema_version",
    "artifact",
    "model",
    "feature_contract",
    "target",
    "provenance",
    "eligibility"
  ],
  "additionalProperties": false,
  "properties": {
    "descriptor_schema_version": {
      "description": "Versioned descriptor format. A new format requires a new schema file and a new validator branch.",
      "const": "artifact_descriptor/v1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "artifact_type",
        "artifact_ref",
        "artifact_sha256",
        "artifact_size_bytes",
        "preprocessing_ref",
        "preprocessing_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "artifact_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact_type": {
          "description": "Serialization container only. The validator hashes bytes and never deserializes any of these formats.",
          "type": "string",
          "enum": [
            "joblib",
            "pickle",
            "onnx",
            "json_trees",
            "safetensors"
          ]
        },
        "artifact_ref": {
          "description": "Relative path inside the caller-supplied artifact source root. Absolute paths, traversal and symlinks are rejected by the source, not by this pattern alone.",
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "preprocessing_ref": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "preprocessing_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_family",
        "preprocessing_version",
        "score_type",
        "calibration",
        "explainability"
      ],
      "properties": {
        "model_family": {
          "description": "Model family. The exact allowlist of registered research families is enforced by the validator (unexpected_model_family), not duplicated here; registration is not an endorsement and not a serving commitment.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "preprocessing_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "score_type": {
          "description": "Declares how a score must be read. It must agree with the calibration status; it can never promote a margin to a probability.",
          "type": "string",
          "enum": [
            "uncalibrated_margin",
            "calibrated_probability",
            "non_interpretable"
          ]
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "calibration_sha256"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "uncalibrated",
                "calibrated",
                "not_assessed"
              ]
            },
            "calibration_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "explainability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "capability"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "tree_shap",
                "lime",
                "none"
              ]
            },
            "capability": {
              "type": "string",
              "enum": [
                "available_in_research_harness",
                "not_implemented"
              ]
            }
          }
        }
      }
    },
    "feature_contract": {
      "description": "The artifact's input contract. Names, order, value types and units are cross-checked against the pinned shared feature schema; the descriptor cannot introduce a private feature dictionary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_schema_id",
        "feature_schema_sha256",
        "features"
      ],
      "properties": {
        "feature_schema_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "feature_schema_sha256": {
          "description": "SHA-256 of the exact shared/contracts/schemas file bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "order",
              "value_type",
              "unit",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "value_type": {
                "type": "string",
                "enum": [
                  "integer",
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_definition_sha256",
        "prediction_timepoint",
        "source_cohort"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "target_definition_sha256": {
          "description": "SHA-256 of the exact registered target definition text. Changing target semantics requires a new registered target id; editing this hash is rejected.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prediction_timepoint": {
          "description": "Declared token for when the predictors are asserted to exist. Recorded for human review; the validator does not adjudicate its clinical correctness.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "source_cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cohort_id",
            "dataset_id",
            "pooled_cohorts"
          ],
          "properties": {
            "cohort_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.:-]{1,127}$"
            },
            "dataset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.:-]{1,127}$"
            },
            "pooled_cohorts": {
              "description": "Must be false. Pooling is not admitted by any current authorization.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "protocol_ref",
        "protocol_sha256",
        "experiment_id",
        "code_commit",
        "generated_at_utc"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "protocol_ref": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "code_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "generated_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_label",
        "serving_status"
      ],
      "properties": {
        "research_label": {
          "description": "The exact evidence label the artifact may carry. Internal exploratory output is never a validated or deployable model.",
          "type": "string",
          "enum": [
            "SYNTHETIC_NON_CLINICAL",
            "INTERNAL_EXPLORATORY_NOT_SUPERVISOR_APPROVED"
          ]
        },
        "serving_status": {
          "description": "APPROVED_FOR_SERVING exists only so that a self-declared serving claim is rejected explicitly instead of being ignored. This release has no independently approved serving status.",
          "type": "string",
          "enum": [
            "RESEARCH_ONLY",
            "APPROVED_FOR_SERVING"
          ]
        }
      }
    }
  }
}
