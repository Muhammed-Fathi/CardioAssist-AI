{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardioassist.local/contracts/term1/schemas/term1_document_extraction_response.schema.json",
  "title": "term1_document_extraction_response.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "document_id",
    "extraction_id",
    "extraction_version",
    "extraction_status",
    "template_id",
    "is_confirmed",
    "confirmed_values_sha256",
    "fields",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "v1"
      ]
    },
    "document_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "extraction_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "extraction_version": {
      "type": "integer",
      "minimum": 1
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "EXTRACTED_DRAFT",
        "NEEDS_MANUAL_REVIEW",
        "UNSUPPORTED_TEMPLATE",
        "CONFIRMED_BY_PATIENT",
        "FAILED"
      ]
    },
    "template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_confirmed": {
      "type": "boolean"
    },
    "confirmed_values_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_name",
          "raw_text",
          "typed_value_json",
          "confirmed_value_json",
          "unit",
          "confidence",
          "conflict_flag",
          "parse_status",
          "provenance_kind"
        ],
        "additionalProperties": false,
        "properties": {
          "field_name": {
            "type": "string"
          },
          "raw_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "typed_value_json": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmed_value_json": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "conflict_flag": {
            "type": "boolean"
          },
          "parse_status": {
            "type": "string",
            "enum": [
              "PARSED",
              "LOW_CONFIDENCE",
              "CONFLICT_REVIEW_REQUIRED",
              "INVALID_VALUE",
              "MISSING",
              "UNRELATED_IGNORED"
            ]
          },
          "provenance_kind": {
            "type": "string",
            "enum": [
              "OCR_EXTRACTED_UNCONFIRMED",
              "OCR_EXTRACTED_PATIENT_CONFIRMED",
              "PATIENT_ENTERED_FROM_OCR_DRAFT",
              "UNRELATED_NON_MODEL_FIELD"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 32
    }
  }
}
