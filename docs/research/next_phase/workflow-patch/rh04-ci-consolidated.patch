diff --git a/.github/workflows/rh04-dual-run-gate.yml b/.github/workflows/rh04-dual-run-gate.yml
new file mode 100644
index 0000000..7f5098e
--- /dev/null
+++ b/.github/workflows/rh04-dual-run-gate.yml
@@ -0,0 +1,273 @@
+name: rh04-dual-run-gate
+
+# RH-04 V2 dual-run window (CAI-RH04-DUALROLLBACK-v3, V2-05).
+#
+# PROPERTY THAT MATTERS MOST: every stage publishes its own result even when
+# another stage fails, and a mandatory failure is never suppressed. Independence
+# is implemented by giving each stage `if: always()` and having it record its own
+# exit code, then having the final gate step read those codes and fail if any
+# *mandatory* stage failed. Nothing is retried, skipped or tolerated into green.
+#
+# Lane A divergence is a *classified finding*, not a pass: training failure,
+# missing evidence and invalid output are failures. Lane B is exact, with no
+# numeric tolerance.
+
+on:
+  pull_request:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: rh04-dual-run-gate-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  dual-run:
+    name: RH-04 dual-run (Python ${{ matrix.python-version }})
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+
+    env:
+      OPENBLAS_NUM_THREADS: '1'
+      OMP_NUM_THREADS: '1'
+      MKL_NUM_THREADS: '1'
+      BLIS_NUM_THREADS: '1'
+      NUMEXPR_NUM_THREADS: '1'
+      VECLIB_MAXIMUM_THREADS: '1'
+
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ['3.11', '3.12']
+
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+
+      - name: Fetch trusted base reference
+        run: |
+          git fetch --no-tags origin "+refs/heads/main:refs/remotes/origin/main"
+          echo "checkout_head=$(git rev-parse HEAD)"
+          echo "base_ref=$(git rev-parse refs/remotes/origin/main)"
+
+      - name: Set up Python
+        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
+        with:
+          python-version: ${{ matrix.python-version }}
+
+      - name: Install pinned dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install \
+            -r research/experiments/requirements.txt \
+            -r research/audit/requirements.txt \
+            -r research/uci412/requirements.txt \
+            -r tests/contracts/requirements.txt
+          # The independent oracle is required evidence. Without it the oracle
+          # test fails closed by design; installing it is not a relaxation.
+          python -m pip install -r research/experiments/requirements-oracle.txt
+          python -m pip check
+
+      - name: Record environment identity
+        run: |
+          python - <<'PY'
+          import importlib.metadata as m, json, subprocess
+          names = ("numpy","scipy","scikit-learn","mpmath","pytest","openpyxl")
+          payload = {}
+          for n in names:
+              try: payload[n] = m.version(n)
+              except Exception: payload[n] = None
+          payload["python"] = subprocess.check_output(["python","-c","import sys;print(sys.version.split()[0])"]).decode().strip()
+          payload["head"] = subprocess.check_output(["git","rev-parse","HEAD"]).decode().strip()
+          try:
+              payload["base_ref"] = subprocess.check_output(["git","rev-parse","refs/remotes/origin/main"]).decode().strip()
+          except Exception:
+              payload["base_ref"] = None
+          # Resident, not requested: OPENBLAS_CORETYPE is a request that may be
+          # silently ignored, so the linked kernels are read at runtime.
+          try:
+              from threadpoolctl import threadpool_info
+              payload["resident_libraries"] = [
+                  {k: v for k, v in e.items() if k in
+                   ("internal_api","user_api","version","prefix","filepath","architecture")}
+                  for e in threadpool_info()
+              ]
+          except Exception as exc:
+              payload["resident_libraries_error"] = type(exc).__name__
+          print(json.dumps(payload, indent=2, sort_keys=True))
+          PY
+
+      # ------------------------------------------------------------------ #
+      # Stage 1 — V1 scoped verification (MANDATORY)
+      # ------------------------------------------------------------------ #
+      - name: "Stage 1 — V1 scoped verification (mandatory)"
+        id: v1
+        if: always()
+        run: |
+          set +e
+          python -m pytest \
+            tests/experiments/test_offline_fixture_pack.py \
+            tests/experiments/test_research_facade.py \
+            tests/contracts -q -W error
+          code=$?
+          echo "stage1_exit=$code" >> "$GITHUB_OUTPUT"
+          exit 0
+
+      # ------------------------------------------------------------------ #
+      # Stage 2 — Lane A classified regeneration evidence (CLASSIFIED)
+      # ------------------------------------------------------------------ #
+      - name: "Stage 2 — Lane A regeneration evidence (classified)"
+        id: lane_a
+        if: always()
+        run: |
+          set +e
+          python - <<'PY'
+          import json, sys
+          from research.intake import rh04_v2_lane_a_convergence as lane_a
+
+          exit_code = 0
+          report = {"lane": "A", "routes": {}}
+          for route_id in ("da_a1_basic_clinical_v1", "da_a2_resting_v1"):
+              try:
+                  document = lane_a.produce_lane_a_evidence(route_id)
+              except Exception as exc:
+                  report["routes"][route_id] = {
+                      "classification": "EVIDENCE_MISSING",
+                      "error": type(exc).__name__,
+                      "is_failure": True,
+                  }
+                  exit_code = 1
+                  continue
+              report["routes"][route_id] = {
+                  "execution_profile": document["execution_profile"],
+                  "n_fits_observed": document["n_fits_observed"],
+                  "residual_min": document["residual_summary"]["min"],
+                  "residual_max": document["residual_summary"]["max"],
+                  "classifications": document["classifications"],
+                  "any_failure": document["any_failure"],
+                  "evidence_sha256": document["evidence_sha256"],
+              }
+              # Trained failure / missing evidence / invalid output are failures.
+              # Diagnostic divergence is reported and does NOT fail the stage.
+              if document["any_failure"]:
+                  exit_code = 1
+          print(json.dumps(report, indent=2, sort_keys=True))
+          sys.exit(exit_code)
+          PY
+          code=$?
+          echo "stage2_exit=$code" >> "$GITHUB_OUTPUT"
+          exit 0
+
+      # ------------------------------------------------------------------ #
+      # Stage 3 — Lane B mandatory exact replay (MANDATORY)
+      # ------------------------------------------------------------------ #
+      - name: "Stage 3 — Lane B exact reference replay (mandatory)"
+        id: lane_b
+        if: always()
+        run: |
+          set +e
+          python - <<'PY'
+          import json, sys
+          from ai import research_facade as facade
+          from research.intake import offline_fixture_pack as v1
+          from research.intake import rh04_v2_portable_archive as archive
+          from research.intake import rh04_v2_value_mapping as mapping
+
+          expected_digest = "891d9e3b2a332c6efc251d97fee25ed46a627ed25b2a089594057b4c9896cdc8"
+          admitted = archive.admit_from_directory("research/intake/fixtures/rh04_v2_portable")
+          result = archive.replay_admitted(facade, admitted)
+          pack = json.loads(v1.PACK.read_text(encoding="utf-8"))
+          order = [c["id"] for c in pack["cases"]]
+          expected = {c["id"]: c["expected"] for c in pack["cases"]}
+          observed = {cid: r for cid, r in zip(order, result["responses"])}
+          document = mapping.mapping_with_discrimination_proof(expected, observed)
+
+          verdict = {
+              "lane": "B",
+              "n_cases": result["n_cases"],
+              "digest": result["digest"],
+              "expected_digest": expected_digest,
+              "matches_reference": result["digest"] == expected_digest,
+              "numeric_tolerance": "none",
+              "leaf_totals": document["leaf_totals"],
+              "total_leaves": document["total_leaves"],
+              "discrimination_proof_detected": document["discrimination_proof"]["detected"],
+          }
+          print(json.dumps(verdict, indent=2, sort_keys=True))
+          # Exact equality only. No tolerance, no near-match, no regeneration.
+          ok = (
+              result["digest"] == expected_digest
+              and result["n_cases"] == 29
+              and document["leaf_totals"].get("NUMERIC_DELTA", 0) == 0
+              and document["discrimination_proof"]["detected"] is True
+          )
+          sys.exit(0 if ok else 1)
+          PY
+          code=$?
+          echo "stage3_exit=$code" >> "$GITHUB_OUTPUT"
+          exit 0
+
+      # ------------------------------------------------------------------ #
+      # Stage 4 — security and regression checks (MANDATORY)
+      # ------------------------------------------------------------------ #
+      - name: "Stage 4 — security and regression checks (mandatory)"
+        id: security
+        if: always()
+        run: |
+          set +e
+          python -m pytest tests/experiments tests/audit -q -W error
+          code=$?
+          echo "stage4_exit=$code" >> "$GITHUB_OUTPUT"
+          exit 0
+
+      # ------------------------------------------------------------------ #
+      # Stage 5 — publish every stage result, then enforce the gate
+      # ------------------------------------------------------------------ #
+      - name: "Stage 5 — publish stage results (always)"
+        if: always()
+        run: |
+          {
+            echo "## RH-04 dual-run — Python ${{ matrix.python-version }}"
+            echo ""
+            echo "| stage | character | exit |"
+            echo "|---|---|---|"
+            echo "| 1. V1 scoped verification | mandatory | ${{ steps.v1.outputs.stage1_exit }} |"
+            echo "| 2. Lane A regeneration evidence | classified | ${{ steps.lane_a.outputs.stage2_exit }} |"
+            echo "| 3. Lane B exact replay | mandatory | ${{ steps.lane_b.outputs.stage3_exit }} |"
+            echo "| 4. Security and regression | mandatory | ${{ steps.security.outputs.stage4_exit }} |"
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: "Stage 5 — enforce gate (mandatory failures are preserved)"
+        if: always()
+        run: |
+          set -euo pipefail
+          s1="${{ steps.v1.outputs.stage1_exit }}"
+          s2="${{ steps.lane_a.outputs.stage2_exit }}"
+          s3="${{ steps.lane_b.outputs.stage3_exit }}"
+          s4="${{ steps.security.outputs.stage4_exit }}"
+          failed=0
+          for pair in "V1 scoped verification:$s1" "Lane A evidence:$s2" "Lane B exact replay:$s3" "Security and regression:$s4"; do
+            name="${pair%%:*}"; code="${pair##*:}"
+            if [ -z "$code" ]; then
+              echo "MANDATORY STAGE DID NOT REPORT: $name" >&2
+              failed=1
+            elif [ "$code" != "0" ]; then
+              echo "STAGE FAILED: $name (exit $code)" >&2
+              failed=1
+            else
+              echo "stage passed: $name"
+            fi
+          done
+          if [ "$failed" -ne 0 ]; then
+            echo ""
+            echo "This job is RED. A red result here is evidence, not noise: every" >&2
+            echo "stage above still published its own outcome." >&2
+            exit 1
+          fi
+          echo "all stages passed on Python ${{ matrix.python-version }}"
